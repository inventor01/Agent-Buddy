# Copy this file to .env for local dev, or paste these into your host's
# environment variables panel (e.g. Railway → Variables) for deployment.
# See README.md for what each of these needs and where to get it.

# --- Supabase (required — the app has no other datastore) ---
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_PROJECT_ID="YOUR_PROJECT"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# --- AI (required for "build my helper" / running a buddy) ---
# Lovable AI gateway key, from your Lovable project's API settings.
LOVABLE_API_KEY=""

# --- SMS via Twilio (optional — SMS delivery silently no-ops without it) ---
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Email via Resend (optional — email delivery silently no-ops without it) ---
RESEND_API_KEY=""
RESEND_FROM_EMAIL="buddy@yourdomain.com"

# --- Scheduled runs (required for the hourly /api/public/hooks/run-due-buddies cron) ---
# Whoever calls that endpoint must send `Authorization: Bearer <this value>`.
LOVABLE_CRON_SECRET=""
LOVABLE_CRON_SECRET_PREVIOUS=""
